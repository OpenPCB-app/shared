{
  "name": "@openpcb/cloud-client",
  "version": "0.1.0",
  "description": "Typed client SDK for the OpenPCB Cloud API — Supabase auth/realtime + cloud-api (/v1) REST. Reuses @openpcb/contracts wire types.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test tests",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "dev": "tsc -p tsconfig.build.json --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenPCB-app/shared.git",
    "directory": "packages/cloud-client"
  },
  "dependencies": {
    "@openpcb/contracts": "github:OpenPCB-app/shared#contracts-v0.2.4"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.47.0"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "@types/bun": "^1.3.5",
    "typescript": "^5.8.3"
  }
}
