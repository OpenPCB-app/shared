      "title": "Visibility",
      "type": "string"
    },
    "storage": {
      "anyOf": [
        {
          "$ref": "#/$defs/StorageRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sourceUrl": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sourceurl"
    },
    "mpn": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mpn"
    },
    "manufacturer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manufacturer"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "license": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "License"
    },
    "owner": {
      "anyOf": [
        {
          "$ref": "#/$defs/OwnerRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "sha256",
    "byteSize",
    "source",
    "visibility"
  ],
  "title": "RegisterRequest",
  "type": "object"
