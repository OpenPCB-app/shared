{
  "$defs": {
    "OwnerRef": {
      "properties": {
        "kind": {
          "enum": [
            "component",
            "design"
          ],
          "title": "Kind",
          "type": "string"
        },
        "workspaceId": {
          "title": "Workspaceid",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "primary": {
          "default": false,
          "title": "Primary",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "workspaceId",
        "id"
      ],
      "title": "OwnerRef",
      "type": "object"
    },
    "StorageRef": {
      "properties": {
        "bucket": {
          "title": "Bucket",
          "type": "string"
        },
        "key": {
          "title": "Key",
          "type": "string"
        }
      },
      "required": [
        "bucket",
        "key"
      ],
      "title": "StorageRef",
      "type": "object"
    }
  },
  "properties": {
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "byteSize": {
      "exclusiveMinimum": 0,
      "title": "Bytesize",
      "type": "integer"
    },
    "source": {
      "enum": [
        "user-upload",
        "vendor-fetch",
        "core-authored"
